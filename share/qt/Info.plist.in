<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist SYSTEM "file://localhost/System/Library/DTDs/PropertyList.dtd">
<plist version="0.9">
<dict>
  <key>LSMinimumSystemVersion</key>
  <string>14</string>

  <key>CFBundleIconFile</key>
  <string>mercatura.icns</string>

  <key>CFBundlePackageType</key>
  <string>APPL</string>

  <key>CFBundleSupportedPlatforms</key>
  <array>
	   <string>MacOSX</string>
  </array>

  <key>NSHumanReadableCopyright</key>
  <string>@MERCATURA_VERSION_MAJOR@.@MERCATURA_VERSION_MINOR@.@MERCATURA_VERSION_BUILD@, Copyright © 2009-@COPYRIGHT_YEAR@ @COPYRIGHT_HOLDERS_FINAL@</string>

  <key>CFBundleShortVersionString</key>
  <string>@MERCATURA_VERSION_MAJOR@.@MERCATURA_VERSION_MINOR@.@MERCATURA_VERSION_BUILD@</string>

  <key>CFBundleVersion</key>
  <string>@MERCATURA_VERSION_MAJOR@.@MERCATURA_VERSION_MINOR@.@MERCATURA_VERSION_BUILD@</string>

  <key>CFBundleSignature</key>
  <string>????</string>

  <key>CFBundleExecutable</key>
  <string>Mercatura-Qt</string>

  <key>CFBundleName</key>
  <string>@CLIENT_NAME@</string>

  <key>LSHasLocalizedDisplayName</key>
  <true/>

  <key>CFBundleIdentifier</key>
  <string>org.mercaturacore.mercatura-qt</string>

  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>CFBundleURLName</key>
      <string>org.mercaturacore.mercatura-payment</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>mercatura</string>
      </array>
    </dict>
  </array>

  <key>NSPrincipalClass</key>
    <string>NSApplication</string>

  <key>NSHighResolutionCapable</key>
    <string>True</string>

  <key>LSApplicationCategoryType</key>
    <string>public.app-category.finance</string>
</dict>
</plist>
